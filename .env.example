# api
OLHOVIVO_TOKEN=
# User-Agent próprio: o padrão de alguns clientes leva 403 na Olho Vivo
OLHOVIVO_USER_AGENT=baldeacao/0.1
DATABASE_URL=postgres://baldeacao:baldeacao@localhost:5432/baldeacao
REDIS_URL=redis://localhost:6379
OTP_URL=http://localhost:8080
NOMINATIM_USER_AGENT=
# web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Origem do app web liberada no CORS da api (REST e Socket.IO)
WEB_ORIGIN=http://localhost:3000
# GTFS da SPTrans (download sem login); o espelho da Mobility Database é usado se o oficial falhar
GTFS_SPTRANS_URL=https://www.sptrans.com.br/umbraco/Surface/PerfilDesenvolvedor/BaixarGTFS?memberName=sptrans
GTFS_SPTRANS_FALLBACK_URL=https://files.mobilitydatabase.org/mdb-8/latest.zip
# Atualização automática do GTFS (cron); padrão: segunda às 4h
GTFS_REFRESH_CRON=0 4 * * 1
