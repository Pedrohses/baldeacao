{
  "name": "@baldeacao/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./examples": {
      "types": "./dist/__examples__.d.ts",
      "default": "./dist/__examples__.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
