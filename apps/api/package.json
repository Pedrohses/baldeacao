{
  "name": "@baldeacao/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "typeorm": "typeorm-ts-node-commonjs -d src/shared/infrastructure/database/data-source.ts",
    "migration:generate": "node scripts/migration-generate.mjs",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "gtfs:import": "ts-node --transpile-only src/modules/sources/presentation/cli/gtfs-import.cli.ts",
    "places:import": "ts-node --transpile-only src/modules/geocoding/presentation/cli/places-import.cli.ts"
  },
  "dependencies": {
    "@baldeacao/types": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/bullmq": "12.0.1",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/platform-socket.io": "12.4.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.3",
    "@nestjs/websockets": "12.4.2",
    "bullmq": "6.7.5",
    "compression": "1.8.2",
    "csv-parse": "7.0.3",
    "fflate": "0.8.3",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.2",
    "@testcontainers/postgresql": "12.2.1",
    "@types/compression": "1.8.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "license": "AGPL-3.0-only"
}
