{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "declaration": false,
    "sourceMap": true,
    "incremental": true,
    "types": ["node", "jest"],
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["src", "test"]
}
